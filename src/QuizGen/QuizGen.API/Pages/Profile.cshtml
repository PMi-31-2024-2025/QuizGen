@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="form-container">
    <h2>Your Profile</h2>
    <hr />
    
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }
    
    <form id="profile-form" method="post">
        <div class="mb-3">
            <label asp-for="ProfileRequest.Name" class="form-label">Name</label>
            <input asp-for="ProfileRequest.Name" class="form-control" />
            <span asp-validation-for="ProfileRequest.Name" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="ProfileRequest.OpenAiApiKey" class="form-label">OpenAI API Key</label>
            <input asp-for="ProfileRequest.OpenAiApiKey" class="form-control" />
            <div class="form-text">Your OpenAI API key is required for quiz generation.</div>
            <span asp-validation-for="ProfileRequest.OpenAiApiKey" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="ProfileRequest.GptModel" class="form-label">GPT Model</label>
            <select asp-for="ProfileRequest.GptModel" class="form-select">
                <option value="gpt-4o">GPT 4o</option>
                <option value="gpt-4o-mini">GPT 4o-mini</option>
            </select>
            <div class="form-text">Select the GPT model you want to use for quiz generation.</div>
            <span asp-validation-for="ProfileRequest.GptModel" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 